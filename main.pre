# 15 "E:\Projects\Asil\Motor Final\MENU\lcd.h"
static void LCD_STROBE()
{
RE0 = 1;
_delay((unsigned long)((500)*(4000000/4000000.0)));
RE0 = 0;
}


void lcd_write(unsigned char c)
{
_delay((unsigned long)((70)*(4000000/4000000.0)));
PORTB = c;
LCD_STROBE();
}


void lcd_clear(void)
{
RE2 = 0;
lcd_write(0x1);
_delay((unsigned long)((2)*(4000000/4000.0)));
}


void lcd_puts(const char * s)
{
RE2 = 1;
while(*s)
lcd_write(*s++);
}


void lcd_putch(char c)
{
RE2 = 1;
lcd_write( c );
}


void lcd_goto(unsigned char pos)
{
RE2 = 0;
lcd_write(0x80+pos);
}

void lcd_init()
{
char init_value;
ADCON1 = 0x06;
CMCON=0x0D;
init_value = 0x3;
TRISE=0;
TRISB=0;
RE2 = 0;
RE0 = 0;
RE1 = 0;
_delay((unsigned long)((30)*(4000000/4000.0)));
PORTB = init_value;
LCD_STROBE();
_delay((unsigned long)((5)*(4000000/4000.0)));
LCD_STROBE();
_delay((unsigned long)((200)*(4000000/4000000.0)));
LCD_STROBE();
_delay((unsigned long)((200)*(4000000/4000000.0)));
PORTB = 0x38;
LCD_STROBE();
lcd_write(0x38);
lcd_write(0xD);
lcd_clear();
lcd_write(0x6);
}

# 8 "E:\Projects\Asil\Motor Final\MENU\rtc.h"
near char A1_ON, A2_ON, A3_ON;

# 28
volatile near unsigned char tickCounter;
volatile near unsigned char newSecond;

near char hours;
near char minutes;
near char seconds;
near bit ampm;

near char a1_hours=0;
near char a1_minutes=0;
near bit a1_ampm=0;
near int a1_duration;

near char a2_hours=0;
near char a2_minutes=0;
near bit a2_ampm=0;
near int a2_duration;

near char a3_hours=0;
near char a3_minutes=0;
near bit a3_ampm=0;
near int a3_duration;

# 5 "E:\Projects\Asil\Motor Final\MENU\main.c"
asm("\tpsect config,class=CONFIG,delta=2"); asm("\tdw ""0x1FFF & 0x3FFD & 0x3FFB & 0x3FFF & 0x3FBF & 0x3F7F");

# 56
unsigned near char MENU_MODE, key, mkey, cursorpos, duration, mincntr, alflag;
near bit lcd_change, buz;


void buzz(void)
{
unsigned char tone=500;
while(tone--)
{
_delay((unsigned long)((50)*(4000000/4000000.0)));
RC0 ^= 1;
}
}


void showtime(char ahours, char aminutes, char aseconds,char aampm, char set)
{
lcd_goto(0x40);
lcd_puts("  ");
if(set)
{

if(ahours/10)
lcd_putch('1');
else
lcd_putch('0');
lcd_putch((ahours%10)+'0');
lcd_putch(':');

lcd_putch((aminutes/10)+'0');
lcd_putch((aminutes%10)+'0');

lcd_putch(':');
lcd_putch((aseconds/10)+'0');
lcd_putch((aseconds%10)+'0');
lcd_putch(' ');
if(aampm)
lcd_putch('P');
else
lcd_putch('A');
lcd_putch('M');
}
else
{
lcd_puts("--:--:-- --");
}
lcd_puts("    ");
}

unsigned char mmkey, mcurpos, tset;

void drawamenu(char stat)
{
switch(mmkey)
{
case 1:{
lcd_puts("   ON ALARM");
switch(stat)
{
case 1: lcd_puts("1?   "); lcd_goto(0x47); if(A1_ON)lcd_puts("YES"); else lcd_puts("NO"); break;
case 2: lcd_puts("2?   "); lcd_goto(0x47); if(A2_ON)lcd_puts("YES"); else lcd_puts("NO"); break;
case 3: lcd_puts("3?   "); lcd_goto(0x47); if(A3_ON)lcd_puts("YES"); else lcd_puts("NO"); break;
}
lcd_goto(0x4F); lcd_putch(0x03);
lcd_goto(0x47); break;
}
case 2:{
lcd_puts("   SET ALARM:"); lcd_goto(0x0f); lcd_putch(0x02);
switch(stat)
{
case 1: showtime(a1_hours, a1_minutes, 0, a1_ampm, A1_ON); break;
case 2: showtime(a2_hours, a2_minutes, 0, a2_ampm, A2_ON); break;
case 3: showtime(a3_hours, a3_minutes, 0, a3_ampm, A3_ON); break;
}
lcd_goto(0x4F); lcd_putch(0x03);
switch(mcurpos)
{
case 0: lcd_goto(0x50); break;
case 1: lcd_goto(0x43); break;
case 2: lcd_goto(0x46); break;
case 3: lcd_goto(0x4C); break;
} break;
}
case 3:{
lcd_puts(" SET DURATION:"); lcd_goto(0x0f); lcd_putch(0x02);
lcd_goto(0x44);
switch(stat)
{
case 1: lcd_putch((a1_duration/100)+'0'); if(a1_duration>=100)lcd_putch(((a1_duration-100)/10)+'0'); else lcd_putch((a1_duration/10)+'0'); lcd_putch((a1_duration%10)+'0'); break;
case 2: lcd_putch((a2_duration/100)+'0'); if(a2_duration>=100)lcd_putch(((a2_duration-100)/10)+'0'); else lcd_putch((a2_duration/10)+'0'); lcd_putch((a2_duration%10)+'0'); break;
case 3: lcd_putch((a3_duration/100)+'0'); if(a3_duration>=100)lcd_putch(((a3_duration-100)/10)+'0'); else lcd_putch((a3_duration/10)+'0'); lcd_putch((a3_duration%10)+'0'); break;
}
lcd_puts(" Mins");
if(tset==2) lcd_goto(0x44); else lcd_goto(0x50); break;
}
}
}

void alarmmenu(char stat, char akey)
{
char a_hr, a_min, a_ampm, a_dur, a_on;
switch(stat)
{
case 1: { a_hr=a1_hours; a_min=a1_minutes; a_on=A1_ON; a_ampm=a1_ampm; a_dur=a1_duration;}break;
case 2: { a_hr=a2_hours; a_min=a2_minutes; a_on=A2_ON; a_ampm=a2_ampm; a_dur=a2_duration;}break;
case 3: { a_hr=a3_hours; a_min=a3_minutes; a_on=A3_ON; a_ampm=a3_ampm; a_dur=a3_duration;}break;
}
switch(akey)
{
case 0x02:
{
switch(tset)
{
case 0: mmkey--; if(mmkey<1)mmkey=1; lcd_change=1; buz=1; break;
case 1: switch(mcurpos)
{
case 1: a_hr++; if(a_hr>12)a_hr=1; lcd_change=1; buz=1; break;
case 2: a_min++; if(a_min>59)a_min=0; lcd_change=1; buz=1; break;
case 3: a_ampm=1; lcd_change=1; buz=1; break;
}break;
case 2: a_dur++; if(a_dur>180)a_dur=0; lcd_change=1; buz=1; break;
}break;
}
case 0x07:
{ switch(tset)
{
case 0: mmkey++; if(mmkey>3)mmkey=3; lcd_change=1; buz=1; break;
case 1: switch(mcurpos)
{
case 1: a_hr--; if(a_hr<1)a_hr=12; lcd_change=1; buz=1; break;
case 2: a_min--; if(a_min<=0)a_min=59; lcd_change=1; buz=1; break;
case 3: a_ampm=0; lcd_change=1; buz=1; break;
}break;
case 2: a_dur--; if(a_dur<=0)a_dur=180; lcd_change=1; buz=1; break;
}break;
}
case 0x03: if(tset==1){mcurpos--; if(mcurpos<1)mcurpos=1; lcd_change=1; buz=1;} break;
case 0x05: if(tset==1){mcurpos++; if(mcurpos>3)mcurpos=3; lcd_change=1; buz=1;} break;
case 0x08: if(tset)tset=0; else{MENU_MODE = 0x02; mkey=stat+1; lcd_change=1; buz=1;} break;
case 0x04:
{
switch(mmkey)
{
case 1: tset=0; if(a_on) a_on=0; else a_on=1; lcd_change=1; buz=1; break;
case 2: tset=1; mcurpos=1; lcd_change=1; buz=1; break;
case 3: tset=2; lcd_change=1; buz=1; break;
}
}
}
switch(stat)
{
case 1: { a1_hours=a_hr; a1_minutes=a_min; A1_ON=a_on; a1_ampm=a_ampm; a1_duration=a_dur;}break;
case 2: { a2_hours=a_hr; a2_minutes=a_min; A2_ON=a_on; a2_ampm=a_ampm; a2_duration=a_dur;}break;
case 3: { a3_hours=a_hr; a3_minutes=a_min; A3_ON=a_on; a3_ampm=a_ampm; a3_duration=a_dur;}break;
}
}


void interrupt isr(void)
{

if((TMR2IE)&&(TMR2IF))
{

if(++tickCounter == 25)
{
tickCounter=0;
newSecond++;
}
TMR2IF=0;
}
}

void main(void)
{

MENU_MODE = 0x03;
mkey=0x01;
key=0x0;
cursorpos=0x01;
lcd_change=1;
buz=1;
mmkey=1;
tset=0;
RC2=0;
duration=0;
mincntr=0;
alflag=0;


TRISD=0xff;
PSPMODE=0;


TRISC = 0;
PORTC = 0;


lcd_init();


static unsigned char newchars[] =
{
0b10000010,0b10000110,0b10001110,0b10011110,0b10001110,0b10000110,0b10000010,0b10000000,
0b10001000,0b10001100,0b10001110,0b10001111,0b10001110,0b10001100,0b10001000,0b10000000,
0b10000000,0b10000100,0b10000100,0b10001110,0b10001110,0b10011111,0b10011111,0b10000000,
0b10000000,0b10011111,0b10011111,0b10001110,0b10001110,0b10000100,0b10000100,0b10000000,
0b10000000,0b10000100,0b10001110,0b10001110,0b10001110,0b10011111,0b10000100,0b10000000,
0b10001110,0b10011111,0b10010111,0b10010111,0b10010111,0b10010111,0b10010111,0b10011111
};
RE2 = 0;
RE1 = 0;
lcd_write(0x40);
lcd_puts(newchars);
RE2 = 0;
lcd_write(0x80);



PIE1 = 0b00000010;
INTCON = 0b01000000;
T2CON = 0b01001110;
PR2 = 0b11111001;
hours = 12;
minutes = 0;
seconds = 0;
ampm = 0;
A1_ON=0; A2_ON=0; A3_ON=0;
RC2=0;


GIE=0;

while(1)
{

key = PORTD;
switch(key)
{
case 0x00: key = 0x0; break;
case 0x01: key = 0x01; break;
case 0x02: key = 0x02; break;
case 0x04: key = 0x03; break;
case 0x08: key = 0x04; break;
case 0x10: key = 0x05; break;
case 0x20: key = 0x06; break;
case 0x40: key = 0x07; break;
case 0x80: key = 0x08; break;
}


if(newSecond)
{
newSecond--;
if(++seconds > 59)
{
seconds=0;
if(A1_ON) if(a1_hours==hours && a1_minutes==(minutes+1) && a1_ampm==ampm) { mincntr=0; duration=a1_duration; RC2=1; alflag=1;}
if(A2_ON) if(a2_hours==hours && a2_minutes==(minutes+1) && a2_ampm==ampm) { mincntr=0; duration=a2_duration; RC2=1; alflag=2;}
if(A3_ON) if(a3_hours==hours && a3_minutes==(minutes+1) && a3_ampm==ampm) { mincntr=0; duration=a3_duration; RC2=1; alflag=3;}
if(alflag)++mincntr;
if(++minutes > 59)
{
minutes = 0;
hours++;
if(hours == 12)
ampm^=1;
if(hours>12)
hours=1;
}
}if(MENU_MODE==0x0 || MENU_MODE==0x02)lcd_change=1;
}

_delay((unsigned long)((60)*(4000000/4000.0)));
if(key)
{
switch(MENU_MODE)
{
case 0x0:
{
switch(key)
{
case 0x01: MENU_MODE = 0x02; mkey=1; lcd_change=1; buz=1; break;
case 0x06: MENU_MODE = 0x01; RC2=1; lcd_change=1; buz=1; break;
case 0x08: MENU_MODE = 0x0; RC2=0; alflag=0; lcd_change=1; buz=1; break;
}break;
}
case 0x01:
{
if(key==0x08){ MENU_MODE = 0x0; RC2=0; alflag=0; lcd_change=1; buz=1; } break;
}
case 0x02:
{_delay((unsigned long)((60)*(4000000/4000.0)));
switch(key)
{
case 0x03: mkey--; if(mkey<1)mkey=1; lcd_change=1; buz=1; break;
case 0x05: mkey++; if(mkey>4)mkey=4; lcd_change=1; buz=1; break;
case 0x04:
{
switch(mkey)
{
case 1: MENU_MODE = 0x03; GIE=0; cursorpos=1; lcd_change=1; mkey=1; buz=1; break;
case 2: MENU_MODE = 0x04; mmkey=1; mcurpos=0; tset=0; lcd_change=1; buz=1; break;
case 3: MENU_MODE = 0x05; mmkey=1; mcurpos=0; tset=0; lcd_change=1; buz=1; break;
case 4: MENU_MODE = 0x06; mmkey=1; mcurpos=0; tset=0; lcd_change=1; buz=1; break;
}
}break;
case 0x08: MENU_MODE = 0x0; lcd_change=1; buz=1; break;
} break;
}
case 0x03:
{_delay((unsigned long)((60)*(4000000/4000.0)));
switch(key)
{
case 0x03: cursorpos--; if(cursorpos<1)cursorpos=1; lcd_change=1; buz=1; break;
case 0x05: cursorpos++; if(cursorpos>4)cursorpos=4; lcd_change=1; buz=1; break;
case 0x02:
{
switch(cursorpos)
{
case 0x01: hours++; if(hours>12)hours=1; break;
case 0x02: minutes++; if(minutes>59)minutes=0; break;
case 0x03: seconds++; if(seconds>59)seconds=0; break;
case 0x04: ampm=1; break;
}lcd_change=1; buz=1; break;
}
case 0x07:
{
switch(cursorpos)
{
case 0x01: hours--; if(hours<1)hours=12; break;
case 0x02: minutes--; if(minutes<=0)minutes=59; break;
case 0x03: seconds--; if(seconds<=0)seconds=59; break;
case 0x04: ampm=0; break;
}lcd_change=1; buz=1; break;
}
case 0x08: MENU_MODE = 0x02; mkey=1; lcd_change=1; GIE=1; buz=1; break;
}break;
}
case 0x04:
{_delay((unsigned long)((60)*(4000000/4000.0)));
alarmmenu(1, key); break;
}
case 0x05:
{_delay((unsigned long)((60)*(4000000/4000.0)));
alarmmenu(2, key); break;
}
case 0x06:
{_delay((unsigned long)((60)*(4000000/4000.0)));
alarmmenu(3, key); break;
}
}
}

if(alflag) if(duration<mincntr) { RC2=0; alflag=0;}


if(buz) {buzz(); buz=0;}



if(lcd_change)
{
lcd_clear();
lcd_goto(0x0);
switch(MENU_MODE)
{
case 0x0:
{
lcd_puts("    SECUTRIX  ");
switch(alflag)
{
case 0: lcd_puts("  "); break;
case 1: lcd_putch(0x04); lcd_putch('1'); break;
case 2: lcd_putch(0x04); lcd_putch('2'); break;
case 3: lcd_putch(0x04); lcd_putch('3'); break;
}
showtime(hours,minutes,seconds,ampm,1);
break;
}
case 0x01:
{
lcd_puts("    SECUTRIX    "); lcd_goto(0x40);
lcd_puts("  MANUAL MODE!  "); break;
}
case 0x02:
{
switch(mkey)
{
case 0x01:
{
lcd_puts("   SET TIME?   "); lcd_putch(0x01);
if(lcd_change){ showtime(hours,minutes,seconds,ampm,1); }break;
}
case 0x02:
{
lcd_putch(0x00); lcd_puts("  SET ALARM1? "); lcd_putch(0x01);
showtime(a1_hours,a1_minutes,0,a1_ampm,A1_ON);
break;
}
case 0x03:
{
lcd_putch(0x00); lcd_puts("  SET ALARM2? "); lcd_putch(0x01);
showtime(a2_hours,a2_minutes,0,a2_ampm,A2_ON);
break;
}
case 0x04:
{
lcd_putch(0x00); lcd_puts("  SET ALARM3?  ");
showtime(a3_hours,a3_minutes,0,a3_ampm,A3_ON);
break;
}
}
}break;
case 0x03:
{
lcd_puts("   SET TIME:   ");
showtime(hours,minutes,seconds,ampm,1);
switch(cursorpos)
{
case 1: lcd_goto(0x43); break;
case 2: lcd_goto(0x46); break;
case 3: lcd_goto(0x49); break;
case 4: lcd_goto(0x4C); break;
}break;
}
case 0x04:
{
drawamenu(1); break;
}
case 0x05:
{
drawamenu(2); break;
}
case 0x06:
{
drawamenu(3); break;
}
}lcd_change=0;
}
}
}
